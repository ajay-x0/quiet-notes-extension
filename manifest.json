{
  "manifest_version": 3,
  "name": "Quiet Notes \u2014 Auto-save Notes",
  "version": "1.0.0",
  "minimum_chrome_version": "102",
  "description": "A calm space for quick notes. Auto-save locally, search, recover deleted notes, and export backups.",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Quiet Notes",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}